{
  "name": "country-map",
  "private": true,
  "version": "0.0.0",
  "description": "3D terrain map of Australia with approximate locations of Aboriginal and Torres Strait Islander nations and language groups",
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": "26.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "data:build": "node scripts/fetch-austlang.ts && node scripts/abs-lookup.ts --nearest && node scripts/wikidata.ts && node scripts/build-nations.ts && node scripts/validate.ts",
    "data:validate": "node scripts/validate.ts"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.14.26",
    "maplibre-gl": "^6.17.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@maplibre/maplibre-gl-style-spec": "^26.5.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "ajv": "^8.20.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jsdom": "^31.0.0",
    "prettier": "^3.9.10",
    "ts-json-schema-generator": "^2.9.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
